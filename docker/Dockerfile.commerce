# Build stage — signal-commerce (Stripe checkout + webhooks)
FROM rust:1.88-alpine AS builder

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconfig

WORKDIR /app

ENV CARGO_NET_RETRY=10 \
    CARGO_HTTP_TIMEOUT=300 \
    CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

COPY Cargo.toml Cargo.lock ./
COPY crates/signal-bot/Cargo.toml crates/signal-bot/
COPY crates/signal-bot-core/Cargo.toml crates/signal-bot-core/
COPY crates/signal-bot-voice/Cargo.toml crates/signal-bot-voice/
COPY crates/near-ai-client/Cargo.toml crates/near-ai-client/
COPY crates/dstack-client/Cargo.toml crates/dstack-client/
COPY crates/signal-client/Cargo.toml crates/signal-client/
COPY crates/signal-registration-proxy/Cargo.toml crates/signal-registration-proxy/
COPY crates/signal-commerce/Cargo.toml crates/signal-commerce/
COPY crates/whisper-client/Cargo.toml crates/whisper-client/
COPY crates/near-agent/Cargo.toml crates/near-agent/

# Minimal stubs so `cargo fetch` can resolve path dependencies
RUN mkdir -p crates/signal-bot/src/commands && \
    echo "pub mod commands; pub mod config; pub mod error; pub mod group_preferences_store; pub mod transcribe_prefs; pub mod entitlements_store;" > crates/signal-bot/src/lib.rs && \
    echo "fn main() {}" > crates/signal-bot/src/main.rs && \
    echo "" > crates/signal-bot/src/commands/mod.rs && \
    echo "" > crates/signal-bot/src/config.rs && \
    echo "" > crates/signal-bot/src/error.rs && \
    echo "" > crates/signal-bot/src/group_preferences_store.rs && \
    echo "" > crates/signal-bot/src/transcribe_prefs.rs && \
    echo "" > crates/signal-bot/src/entitlements_store.rs && \
    mkdir -p crates/signal-bot-core/src && echo "pub fn dummy() {}" > crates/signal-bot-core/src/lib.rs && \
    mkdir -p crates/signal-bot-voice/src && echo "pub fn dummy() {}" > crates/signal-bot-voice/src/lib.rs && \
    mkdir -p crates/near-ai-client/src && echo "pub fn dummy() {}" > crates/near-ai-client/src/lib.rs && \
    mkdir -p crates/dstack-client/src && echo "pub fn dummy() {}" > crates/dstack-client/src/lib.rs && \
    mkdir -p crates/signal-client/src && echo "pub fn dummy() {}" > crates/signal-client/src/lib.rs && \
    mkdir -p crates/whisper-client/src && echo "pub fn dummy() {}" > crates/whisper-client/src/lib.rs && \
    mkdir -p crates/near-agent/src && echo "pub fn dummy() {}" > crates/near-agent/src/lib.rs && \
    mkdir -p crates/signal-registration-proxy/src && \
    echo "fn main() {}" > crates/signal-registration-proxy/src/main.rs && \
    mkdir -p crates/signal-commerce/src && \
    echo "fn main() {}" > crates/signal-commerce/src/main.rs && \
    echo "" > crates/signal-commerce/src/lib.rs

RUN cargo fetch --locked

RUN cargo build --release -p signal-commerce 2>/dev/null || true

COPY crates crates

RUN find crates -name "*.rs" -exec touch {} \;

RUN cargo build --release --locked --offline --bin signal-commerce

# Runtime stage
FROM alpine:3.21

# wget: compose / Phala healthcheck against /health
RUN apk add --no-cache ca-certificates wget

RUN mkdir -p /data && chown 1000:1000 /data

COPY --from=builder /app/target/release/signal-commerce /signal-commerce

RUN adduser -D -u 1000 appuser
USER appuser

EXPOSE 8082

ENTRYPOINT ["/signal-commerce"]
