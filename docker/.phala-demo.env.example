# NEAR HACKATHON demo CVM env — copy to docker/.phala-demo.env (never commit it).
#
# Secrets only. Every other setting is written into docker/phala-demo.yaml so it is
# part of the measured compose hash.

# The demo bot's own Signal number, not production's.
SIGNAL_PHONE=

NEAR_AI_API_KEY=

# Testnet account that funds each boot's agent account (0.5 NEAR per boot, mostly prepaid gas),
# and its full-access key from the NEAR CLI keychain, `ed25519:...`. Use a dedicated
# account holding only a small float: anyone who compromises the CVM gets this key.
AGENT_SPONSOR_ACCOUNT_ID=
AGENT_SPONSOR_PRIVATE_KEY=

# No DSTACK_AUTHORIZED_KEYS: SSH into the demo CVM would undercut the privacy claim.
